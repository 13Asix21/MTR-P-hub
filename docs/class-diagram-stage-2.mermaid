classDiagram
direction LR

class Stage2ConfigLoader {
  +load(config_dir: str, mode: ExecutionMode) Stage2RuntimeConfig
  +validate_cross_registry(loaded: LoadedConfig) void
  +validate_audit_outside_vault(config_dir: str) void
}
class Stage2RuntimeConfig {
  +obsidian: ObsidianConfig
  +lexiang_m: LexiangConfig
  +github_p: GitHubConfig
  +workbuddy_manifest: WorkbuddyManifestConfig
  +execution_config_hash() str
}
class ObsidianConfig {
  +mode: str
  +vault_id: str
  +vault_root: str
  +managed_roots: Tuple~ManagedRoot~
  +excluded_roots: Tuple~RelativePath~
  +trial_tag: str
  +rarely_tag: str
  +read_only: bool
  +follow_symlinks: bool
  +g1_confirmed: bool
  +max_file_bytes: int
  +max_scan_files: int
  +max_results: int
}
class LexiangConfig {
  +mode: str
  +team_id: str
  +space_id: str
  +root_entry_id: str
  +read_only: bool
  +allow_empty: bool
  +search_modes: Tuple~SearchMode~
  +max_results: int
  +vector_threshold: float
  +max_entry_bytes: int
  +timeout_seconds: int
}
class GitHubConfig {
  +mode: str
  +read_only: bool
  +timeout_seconds: int
  +max_file_bytes: int
  +repositories: Tuple~GitHubRepositoryBinding~
}
class WorkbuddyManifestConfig {
  +schema_version: str
  +tool_profile: str
  +max_steps: int
  +max_entry_reads: int
  +max_envelope_bytes: int
  +persist_raw_responses: bool
}
class GitHubRepositoryBinding {
  +project_id: str
  +repo_id: str
  +location_id: str
  +owner: str
  +repo: str
  +read_paths: Tuple~RelativePath~
  +adr_files: Tuple~RelativePath~
}

class ManifestService {
  +create(request: RouteQueryRequest, mode: ExecutionMode) ExecutionManifest
  +verify(request: RouteQueryRequest, manifest: ExecutionManifest) ManifestVerification
  -prepare_route(request: RouteQueryRequest) Stage2RoutePlan
}
class ManifestCompiler {
  +compile(request: RouteQueryRequest, route: Stage2RoutePlan, config: Stage2RuntimeConfig) ExecutionManifest
  -expand_p(step: ReadStep) Tuple~ManifestStep~
  -expand_m(step: ReadStep) Tuple~ManifestStep~
  -expand_view(step: ReadStep) ManifestStep
}
class ManifestVerifier {
  +verify_intrinsic(manifest: ExecutionManifest) void
  +verify_expected(actual: ExecutionManifest, expected: ExecutionManifest) void
  +verify_before_call(manifest: ExecutionManifest, expected_hash: str) void
  -verify_profile_step(step: ManifestStep) void
  -verify_bindings(steps: Tuple~ManifestStep~) void
}
class Stage2RoutePlan {
  +schema_version: str
  +intent: Intent
  +rule_version: str
  +policy_hash: str
  +registry_hash: str
  +execution_config_hash: str
  +request_hash: str
  +plan_hash: str
  +mode: ExecutionMode
  +project_coordinate: Optional~ProjectCoordinate~
  +steps: Tuple~ReadStep~
}
class ExecutionManifest {
  +schema_version: str
  +mode: ExecutionMode
  +read_only: bool
  +request_id: str
  +route_id: str
  +execution_id: str
  +request_hash: str
  +plan_hash: str
  +manifest_hash: str
  +tool_profile: str
  +profile_hash: str
  +execution_config_hash: str
  +limits: ExecutionLimits
  +steps: Tuple~ManifestStep~
  +hashed_payload() JsonObject
  +trace_id() str
}
class ExecutionLimits {
  +max_steps: int
  +max_entry_reads: int
  +max_tool_calls: int
  +max_file_bytes: int
  +max_entry_bytes: int
  +max_envelope_bytes: int
  +max_scan_files: int
  +max_results: int
}
class ManifestStep {
  +step_id: str
  +route_step_id: str
  +executor: ExecutorKind
  +adapter: AdapterKind
  +operation: str
  +arguments: JsonObject
  +on_empty: EmptyAction
  +on_unavailable: EmptyAction
  +read_only: bool
}
class StepBinding {
  +from_step: str
  +field: str
}
class ManifestVerification {
  +manifest_hash: str
  +profile_hash: str
  +verified_step_count: int
  +external_call_permitted: bool
}

class Stage2ReadonlyProfile {
  +name: str
  +profile_hash() str
  +spec_for(step: ManifestStep) ToolSpec
  +validate_arguments(step: ManifestStep) void
  +validate_response(step: ManifestStep, response: RawResponse) void
}
class ToolSpec {
  +operation: str
  +transport_tool_id: str
  +inner_tool_names: Tuple~str~
  +fixed_argument_schema: JsonObject
  +binding_contract: JsonObject
  +response_contract: str
  +real_response_verified: bool
}
class BindingResolver {
  +resolve(step: ManifestStep, prior: Tuple~ExecutionReceipt~) ResolvedCalls
  -scalar_commit(binding: StepBinding) str
  -entry_candidates(binding: StepBinding) Tuple~EntryCandidate~
  -reject_empty_or_prefix(value: str) void
}
class ResolvedCalls {
  +step_id: str
  +calls: Tuple~PlannedToolCall~
  +skip_status: Optional~StepStatusV2~
  +skip_reason: Optional~str~
}
class PlannedToolCall {
  +call_id: str
  +tool_id: str
  +inner_tool_name: Optional~str~
  +arguments: JsonObject
}

class WorkBuddyManifestExecutor {
  +execute(manifest: ExecutionManifest, envelope: Optional~ExecutionEnvelope~) ExecutionEnvelope
  -execute_remote_step(step: ManifestStep) ExecutionReceipt
  -invoke(planned: PlannedToolCall) ToolCallReceipt
  -stop_at_core_step(next_step_id: str) ExecutionEnvelope
}
class WorkBuddyToolTransport {
  <<interface>>
  +invoke(tool_id: str, inner_tool_name: Optional~str~, arguments: JsonObject, timeout_seconds: int) RawToolOutcome
}
class RawToolOutcome {
  +response: Optional~RawResponse~
  +error_kind: Optional~ToolErrorKind~
  +duration_ms: int
}
class RawResponse {
  +kind: str
  +data: Optional~JsonValue~
  +text: Optional~str~
  +response_sha256() str
}
class ToolCallReceipt {
  +call_id: str
  +tool_id: str
  +inner_tool_name: Optional~str~
  +arguments: JsonObject
  +arguments_sha256: str
  +response: Optional~RawResponse~
  +response_sha256: Optional~str~
  +status: StepStatusV2
  +reason_code: Optional~str~
  +duration_ms: int
}
class ExecutionReceipt {
  +step_id: str
  +route_step_id: str
  +manifest_hash: str
  +execution_id: str
  +status: StepStatusV2
  +reason_code: Optional~str~
  +calls: Tuple~ToolCallReceipt~
  +binding_data: JsonObject
  +receipt_hash: str
  +calculate_hash() str
}
class ExecutionEnvelope {
  +schema_version: str
  +mode: ExecutionMode
  +request_id: str
  +route_id: str
  +execution_id: str
  +trace_id: str
  +manifest_hash: str
  +profile_hash: str
  +receipts: Tuple~ExecutionReceipt~
  +core_receipts: Tuple~CoreStepReceipt~
  +next_step_id: Optional~str~
  +continuation_hash: str
  +envelope_hash() str
}
class CoreStepReceipt {
  +step_id: str
  +route_step_id: str
  +execution: StepExecutionV2
  +scan: Optional~VaultScanSummary~
}

class ObsidianAdapter {
  +execute(step: ManifestStep, context: Stage2ExecutionContext) StepExecutionV2
  +inventory(context: Stage2ExecutionContext) VaultInventory
}
class SafeVaultIO {
  +prepare_scope(config: ObsidianConfig) PreparedVaultScope
  +iter_markdown(scope: PreparedVaultScope) Iterable~VaultCandidate~
  +open_verified(candidate: VaultCandidate) VerifiedVaultFile
  -lexical_allow(path: PurePosixPath) bool
  -check_no_reparse(path: Path) void
  -check_containment(path: Path) void
  -double_read_hash(handle: BinaryIO) VerifiedBytes
}
class PreparedVaultScope {
  +vault_root: Path
  +managed_roots: Tuple~Path~
  +excluded_roots: Tuple~PurePosixPath~
  +scope_sha256: str
}
class VerifiedVaultFile {
  +relative_path: str
  +managed_root_id: str
  +raw_bytes: bytes
  +content_sha256: str
}
class ObsidianMarkdownParser {
  +parse(raw_bytes: bytes, relative_path: str) ParsedObsidianDocument
  -frontmatter_tags(lines: Tuple~str~) Tuple~str~
  -inline_tags_outside_code(lines: Tuple~str~) Tuple~str~
}
class ParsedObsidianDocument {
  +title: str
  +tags: Tuple~str~
  +classification: str
  +needs_classification: bool
  +has_trial: bool
  +has_rarely: bool
}
class VaultScanSummary {
  +scope_sha256: str
  +scanned_count: int
  +matched_count: int
  +unmanaged_count: int
  +conflict_count: int
  +skipped_count: int
  +error_count: int
  +inventory_sha256: str
}

class LexiangMAdapter {
  +normalize(route_step: ReadStep, receipts: Tuple~ExecutionReceipt~, context: Stage2ExecutionContext) StepExecutionV2
  -space(receipt: ExecutionReceipt) SpaceResolution
  -search(receipt: ExecutionReceipt) SearchBatch
  -entries(receipt: ExecutionReceipt) Tuple~KnowledgeEntryData~
}
class GitHubPAdapter {
  +normalize(route_step: ReadStep, receipts: Tuple~ExecutionReceipt~, context: Stage2ExecutionContext) StepExecutionV2
  -branches(receipt: ExecutionReceipt) BranchBatch
  -commit(receipt: ExecutionReceipt) str
  -file(receipt: ExecutionReceipt) GitHubFileData
}
class Stage2ExecutionContext {
  +request_id: str
  +route_id: str
  +execution_id: str
  +trace_id: str
