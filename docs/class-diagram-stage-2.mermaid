}

class QueryFinalizationService {
  +finalize(request: RouteQueryRequest, expected_manifest_hash: str, envelope: ExecutionEnvelope) FinalizationOutput
  -verify_prefix(manifest: ExecutionManifest, envelope: ExecutionEnvelope) void
  -execute_core_barrier(manifest: ExecutionManifest, envelope: ExecutionEnvelope) ExecutionEnvelope
  -normalize_completed(manifest: ExecutionManifest, envelope: ExecutionEnvelope) QueryResponseV2
  -continuation(envelope: ExecutionEnvelope) ContinuationOutput
}
class Stage2DecisionLog {
  +record_plan(manifest: ExecutionManifest) void
  +begin_run(envelope: ExecutionEnvelope) ExecutionRun
  +continue_run(envelope: ExecutionEnvelope) ExecutionRun
  +finish_run(run: ExecutionRun, response: QueryResponseV2) void
  +reject_run(run: Optional~ExecutionRun~, error: MtrpError) void
  +find(request_id: Optional~str~, route_id: Optional~str~, execution_id: Optional~str~, trace_id: Optional~str~) Tuple~DecisionQueryRecord~
}
class ExecutionRun {
  +run_seq: int
  +execution_id: str
  +trace_id: str
  +status: str
  +last_continuation_hash: str
}

Stage2ConfigLoader ..> Stage2RuntimeConfig : creates
Stage2RuntimeConfig *-- ObsidianConfig
Stage2RuntimeConfig *-- LexiangConfig
Stage2RuntimeConfig *-- GitHubConfig
Stage2RuntimeConfig *-- WorkbuddyManifestConfig
GitHubConfig *-- GitHubRepositoryBinding
ManifestService --> ManifestCompiler
ManifestService --> ManifestVerifier
ManifestService --> Stage2ConfigLoader
ManifestCompiler ..> Stage2RoutePlan : uses
ManifestCompiler ..> ExecutionManifest : creates
ExecutionManifest *-- ExecutionLimits
ExecutionManifest *-- ManifestStep
ManifestStep --> StepBinding : declarative arguments
ManifestVerifier --> Stage2ReadonlyProfile
Stage2ReadonlyProfile o-- ToolSpec
WorkBuddyManifestExecutor --> ManifestVerifier : verifies before first call
WorkBuddyManifestExecutor --> BindingResolver
WorkBuddyManifestExecutor --> WorkBuddyToolTransport : host supplied only
WorkBuddyManifestExecutor --> Stage2ReadonlyProfile
BindingResolver ..> ResolvedCalls : creates
ResolvedCalls *-- PlannedToolCall
WorkBuddyManifestExecutor ..> ExecutionEnvelope : creates
ExecutionEnvelope *-- ExecutionReceipt
ExecutionEnvelope *-- CoreStepReceipt
ExecutionReceipt *-- ToolCallReceipt
ToolCallReceipt *-- RawResponse
ObsidianAdapter --> SafeVaultIO
ObsidianAdapter --> ObsidianMarkdownParser
SafeVaultIO ..> PreparedVaultScope : creates
SafeVaultIO ..> VerifiedVaultFile : creates
ObsidianMarkdownParser ..> ParsedObsidianDocument : creates
ObsidianAdapter ..> VaultScanSummary : creates
LexiangMAdapter --> ExecutionReceipt : normalizes
GitHubPAdapter --> ExecutionReceipt : normalizes
QueryFinalizationService --> ManifestVerifier
QueryFinalizationService --> ObsidianAdapter
QueryFinalizationService --> LexiangMAdapter
QueryFinalizationService --> GitHubPAdapter
QueryFinalizationService --> Stage2DecisionLog
QueryFinalizationService ..> QueryResponseV2 : creates
QueryFinalizationService ..> ContinuationOutput : creates
CoreStepReceipt *-- StepExecutionV2
StepExecutionV2 *-- StepResultV2
StepExecutionV2 *-- ResourceV2
StepExecutionV2 *-- EvidenceV2
StepResultV2 *-- OperationResult
CanonicalResultV2 *-- ResourceV2
CanonicalResultV2 *-- EvidenceV2
QueryResponseV2 *-- StepResultV2
QueryResponseV2 *-- CanonicalResultV2
ContinuationOutput *-- ExecutionEnvelope
Stage2DecisionLog ..> ExecutionRun : creates and resumes
ResourceV2 --> SourceRef
ResourceV2 --> SnapshotRef
EvidenceV2 --> SourceRef
EvidenceV2 --> SnapshotRef
ResourceV2 ..> Resource : explicit downgrade only
EvidenceV2 ..> Evidence : explicit downgrade only
CanonicalResultV2 ..> CanonicalResult : explicit downgrade only
